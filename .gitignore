# ==========================================
# Indian Currency AI - Git Ignore Configuration
# ==========================================

# Environments & Virtual Envs
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Large Datasets & Images (Store raw datasets on Drive/Cloud)
dataset/denomination/*
!dataset/denomination/.gitkeep
dataset/authenticity/*
!dataset/authenticity/.gitkeep
*.png
*.jpg
*.jpeg
*.bmp
*.tiff

# Large Trained Model Binaries
models/*
!models/.gitkeep
*.h5
*.keras
*.pb
*.onnx
*.tflite
*.pkl
*.joblib

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Frontend / Web dependencies & builds
node_modules/
build/
dist/
.env
.env.local

# Temporary files & logs
*.log
temp_*
scratch/
results/*.png
results/*.jpg
!results/.gitkeep
